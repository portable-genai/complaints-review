# B6 Complaints & Conduct File Review : example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The local/test profile needs NONE of the GCP-specific values : only COMPLAINTS_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  'local' is a WORKING offline stack (SQLite FTS5
# retrieval, deterministic LLM, regex DLP, heuristic guardrail) that runs end to end with
# no Google Cloud, no API key and no emulators: the default for dev and test. 'onprem' is
# the fail-fast Google Distributed Cloud migration target.
COMPLAINTS_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Local profile stores (local profile only). Empty => per-package defaults under
# ~/.complaints_review/ ; set to a path to relocate, or to ':memory:' for ephemeral.
# ---------------------------------------------------------------------------
COMPLAINTS_LOCAL_DB=
COMPLAINTS_LOCAL_AUDIT=

# Optional higher-fidelity local stores via Google's official emulators (opt-in, never
# required). When set AND the [gcp] extra is installed, the local registry routes to the
# Firestore emulator; otherwise it stays on the in-process path. No emulator is required
# for the default offline run.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml : not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
COMPLAINTS_KMS_KEY=

# Toggle public-web grounding. Off by default for B6 (closed perimeter). true | false.
COMPLAINTS_GROUNDING_ENABLED=false

# ---------------------------------------------------------------------------
# Document extraction : Document AI (gcp profile)
# ---------------------------------------------------------------------------
# Processor id: projects/.../locations/asia-southeast1/processors/...
COMPLAINTS_DOCAI_PROCESSOR=
COMPLAINTS_DOCAI_VERSION=

# ---------------------------------------------------------------------------
# PII redaction : Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
COMPLAINTS_DLP_INSPECT_TEMPLATE=
COMPLAINTS_DLP_DEIDENTIFY_TEMPLATE=

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
COMPLAINTS_AGENT_ENGINE=

# ---------------------------------------------------------------------------
# Identity & embedding surface (see docs/embedding-and-identity.md)
# ---------------------------------------------------------------------------
# Cloud IAP audience: the exact structured protected-resource path the backend verifies
# the injected x-goog-iap-jwt-assertion against. Required in the gcp/platform profiles.
COMPLAINTS_IAP_AUDIENCE=
# Explicit CORS origin allowlist for the cross-origin / standalone case (comma-separated).
# NEVER "*"; unset falls back to the localhost:3000 dev origins. Same-origin embed needs none.
COMPLAINTS_CORS_ORIGINS=
# CSP frame-ancestors allowlist: parent origins permitted to iframe the UI (space-separated).
# Defaults to 'self' (standalone; nothing may frame it).
COMPLAINTS_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Platform-profile sibling service URLs (consumed by the platform adapters).
# Defaults point at localhost; override per deployment.
# ---------------------------------------------------------------------------
HRZ_GUARDRAIL_URL=http://localhost:8080      # A1 guardrail + redaction
HRZ_KB_URL=http://localhost:8082             # A2 enterprise knowledge base (B6's RAG store)
HRZ_REGISTRY_URL=http://localhost:8083       # A3 agent registry
HRZ_QUALITY_URL=http://localhost:8084        # A4 AI quality / eval gate
HRZ_OBSERVABILITY_URL=http://localhost:8085  # A5 observability / audit

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# COMPLAINTS_SETTINGS=config/settings.yaml
